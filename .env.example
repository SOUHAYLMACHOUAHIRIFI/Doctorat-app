# ==============================================================================
# GCD USMBA — Plateforme Universitaire de Gestion du Cycle Doctoral
# Université Sidi Mohamed Ben Abdellah de Fès
# Fichier d'exemple des variables d'environnement
# ==============================================================================

# Port d'écoute du serveur unifié (Backend Express + Frontend Vite)
PORT=3000
NODE_ENV=development

# Clé secrète pour les jetons de session JWT (Changez cette valeur en production)
JWT_SECRET=gcd_usmba_jwt_super_secure_random_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Base de données PostgreSQL (Pour déploiement externe avec Docker / Supabase / Neon / Cloud SQL)
DATABASE_URL="postgresql://gcd_user:gcd_password@localhost:5432/gcd_usmba?schema=public"

# Durée de validité des sessions et cookies sécurisés (en millisecondes : 7 jours)
SESSION_MAX_AGE=604800000

# Limiteur de requêtes (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Configuration CORS (Domaines autorisés en production)
CORS_ORIGIN=http://localhost:3000

# Email institutionnel requis pour les candidats
INSTITUTIONAL_EMAIL_DOMAIN=@usmba.ac.ma
